{
  "name": "hexachess-rooms",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "HEXACHESS_FRONTEND_ORIGIN": "https://YOUR-OWNER.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hexachess-rooms",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
